# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/

# Models — never commit weights (Section 16/23); download via scripts/models.py
# (matches nested pack directories too, e.g. models/face/models/buffalo_l/*.onnx
# — confirmed this actually happens: insightface's download layout nests one
# level deeper than a flat models/face/*.onnx pattern would catch)
models/face/**
models/voice/**
!models/registry.yaml
!models/face/.gitkeep
!models/voice/.gitkeep

# Reference images / session data — Section 5/21: never retained beyond a session
data/sessions/

# Benchmark artifacts are useful to keep for docs (JSON metrics), but not raw
# captured media — a camera-sample-frame.jpg is a real photo of your room
# (Section 21 privacy: keep captured media local, don't commit it by default).
benchmarks/*.mp4
benchmarks/*.wav
benchmarks/*.jpg
benchmarks/*.png

# Local env / secrets
.env
.env.local

# OS / editor
.DS_Store
*.swp
