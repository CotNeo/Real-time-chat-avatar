# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/

# Models — never commit weights (Section 16/23); download via scripts/models.py
models/face/*.onnx
models/face/*.pth
models/voice/**/*.pth
models/voice/**/*.onnx
models/voice/**/*.bin
models/voice/**/*.safetensors
!models/registry.yaml

# Reference images / session data — Section 5/21: never retained beyond a session
data/sessions/

# Benchmark artifacts are useful to keep for docs (JSON metrics), but not raw
# captured media — a camera-sample-frame.jpg is a real photo of your room
# (Section 21 privacy: keep captured media local, don't commit it by default).
benchmarks/*.mp4
benchmarks/*.wav
benchmarks/*.jpg
benchmarks/*.png

# Local env / secrets
.env
.env.local

# OS / editor
.DS_Store
*.swp
