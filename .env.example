# Copy to .env and adjust. All values are also overridable via AVATAR__* env
# vars against configs/default.yaml (see shared/schemas/config.py) — this file
# covers the handful of settings that are secrets/deployment-specific rather
# than pipeline tuning knobs.

# Section 21 — Privacy: when true, the app must never call any external network
# API (no cloud face/voice services, no telemetry). This is the default and the
# expected setting for this project; only flip it off if you deliberately wire
# in an external service and understand the privacy trade-off.
LOCAL_ONLY=true

# services/api
# NOTE: 8000 is already occupied by an unrelated service on the dev machine
# (confirmed via `ss -tln`) — 8100 is used as this project's default instead.
API_HOST=127.0.0.1
API_PORT=8100

# apps/web (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100

# Override the config file path if you don't want configs/default.yaml
AVATAR_CONFIG_PATH=configs/default.yaml
